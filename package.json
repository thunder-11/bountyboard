{
  "name": "bountyboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "db:setup": "node scripts/setup.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/test-database.js integration",
    "test:e2e": "node scripts/test-database.js e2e",
    "db:up": "docker compose up -d --wait",
    "db:jobs": "node scripts/jobs.js",
    "verify": "node scripts/verify.js",
    "test:docs": "node scripts/validate-docs.js"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "lucide-react": "0.468.0",
    "mongodb": "6.21.0",
    "mysql2": "3.24.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=22"
  }
}
